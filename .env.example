# Meridian environment — COPY to .env for LOCAL dev only. NEVER commit .env. NEVER copy it to the server.
# Sır çözüm sırası (IaC-K5, 2026-09-07): systemd credential → ortam değişkeni → `state/secrets.json`
# (0600). Bulut sır deposu kanalı SİLİNDİ; sunucuda da okunan yer aynı üç basamaktır.

# --- data / broker secrets (yerelde gerçek değerleri buraya; sunucuda state/secrets.json) ---
FMP_API_KEY=                 # Financial Modeling Prep — enables FMP screeners. Absent = those skills stay disabled.
ALPACA_PAPER_KEY=            # Alpaca PAPER key id. Absent = engine uses the internal broker simulator.
ALPACA_PAPER_SECRET=         # Alpaca PAPER secret.
HERMES_API_KEY=              # Anthropic API key for the Hermes brain (VM only).

# --- mode flags (L0 defaults — DO NOT change these to go live without passing §8 promotion gates) ---
MERIDIAN_MODE=paper          # paper | live   — live also requires MERIDIAN_I_ACCEPT_RISK=true AND autonomy_level>=1
MERIDIAN_I_ACCEPT_RISK=false # must be hand-set to true by a human to even import the live broker path

# --- infra (VM only) ---
# Bulut sır deposunun proje değişkeni KALDIRILDI (IaC-K5, 2026-09-07): hiçbir kod onu okumuyordu;
# doldurulduğunda "ayar yapıldı" izlenimi veren ölü bir kabloydu. Adı burada da yazılı DEĞİL —
# operatör-yüzlü bir şablonda ölü bir anahtarın adı, doldurulmaya davettir. Aynı gerekçeyle systemd
# biriminin `Environment=` satırı ve pano kaynak sözlüğü de temizlendi.
MERIDIAN_DASH_TOKEN=         # panonun paylaşılan betik jetonu (A1'de systemd credential'dan gelir).
                             # Pano dışarı açık DEĞİL: erişim `ssh -L 8080:127.0.0.1:8080` tüneliyle.
