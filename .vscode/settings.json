{
  // Meridian — VS Code çalışma alanı ayarları (2026-09-16). Bu dosya DEPO-SAHİPLİDİR: yeni bir
  // makinede aynı yorumlayıcı/test/izleyici davranışı doğsun diye versiyonlanır. Kişisel tercihler
  // `.vscode/settings.local.json`a (git-ignore) yazılır. Depo KURALLARI burada DEĞİL, CLAUDE.md'dedir.

  // --- Python: tek yorumlayıcı, venv'in kendisi (CLAUDE.md §6: her koşum .venv/bin/python) -------
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,

  // --- Test: pytest AÇIK ama KEŞİF KAYDETMEDE KOŞMAZ -------------------------------------------
  // Suite 13k+ test taşıyor; her kaydetmede yeniden keşif hem yavaş hem de Rol-1'in otoriter
  // koşumuyla aynı pencereye düşebilir (hafıza: paralel ajan test çakışması). Keşif elle tetiklenir.
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.autoTestDiscoverOnSaveEnabled": false,
  "python.testing.pytestArgs": ["tests", "-p", "no:cacheprovider"],

  // --- Dosya izleyici: büyük ve canlı-sahipli dizinler dışarıda --------------------------------
  // `state/` (defterler, bar CSV'leri), `research/olcumler/` (~289 MB ölçüm artefaktı), venv ve
  // node_modules izlenirse VS Code sürekli yeniden tarar. Arama `.gitignore`a zaten saygı duyar.
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/state/**": true,
    "**/backups/**": true,
    "**/research/olcumler/**": true,
    "**/node_modules/**": true,
    "**/__pycache__/**": true,
    "**/.claude/worktrees/**": true,
    "**/altyapi/**/.terraform/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.claude/worktrees": true
  },

  // --- Editör: üretilmiş dosyalara dokunmayı zorlaştırma, tutarlı biçim ------------------------
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "editor.rulers": [100],
  "[markdown]": { "files.trimTrailingWhitespace": false },

  // docs/RUNBOOK.md ve research/cards/README.md ÜRETİLMİŞTİR (ops/runbook_uret.py,
  // ops/kart_endeksi_uret.py) — elle düzenlenmez; salt-okur açılır ki kaza eseri yazılmasın.
  "files.readonlyInclude": {
    "docs/RUNBOOK.md": true,
    "research/cards/README.md": true,
    "altyapi/apisix/import.tf": true
  },

  // --- Ansible (redhat.ansible) ----------------------------------------------------------------
  // Yorumlayıcı venv'e bağlanınca eklenti `.venv/bin`i PATH'in başına koyar: `ansible`,
  // `ansible-playbook --syntax-check` ve `ansible-lint` depo pinli sürümlerle koşar (eklenti
  // kaynağından ölçüldü, 2026-09-16). Yapılandırma kökteki `ansible.cfg` + `.ansible-lint`ten gelir
  // (production profili); `ansible.posix` koleksiyonu `~/.ansible/collections`tadır.
  // Execution environment KAPALI: konteyner motoru arar, bu makinede çalışan motor yok.
  // Lightspeed KAPALI: oyun kitabı içeriğini dış bir LLM servisine gönderir (sır adları, envanter).
  "ansible.python.interpreterPath": "${workspaceFolder}/.venv/bin/python",
  "ansible.validation.enabled": true,
  "ansible.validation.lint.enabled": true,
  "ansible.validation.lint.autoFixOnSave": false,
  "ansible.executionEnvironment.enabled": false,
  "ansible.lightspeed.enabled": false,
  "ansible.lightspeed.suggestions.enabled": false,

  // MCP sunucusu KAPALI (operatör 2026-09-16, düğmeyle açıldı → ölçüm sonrası geri alındı).
  // Eklenti kaynağından ölçüldü (redhat.ansible 26.8.2, packages/ansible-mcp-server): sunucu
  // 10 araç sunar ve VS Code içindeki AI asistanına açılır. Üçü bu depoda doğrudan zararlıdır:
  //   - ansible-navigator run <playbook>: playbook KOŞTURUR ve yorumlayıcıyı ararken
  //     .venv/bin'i de tarar → dagit.sh'nin 17 kapısı (temiz ağaç, kuru koşum, mtime, worker
  //     durdurma) ATLANIR. Dağıtım yalnız Rol-1'indir (CLAUDE.md §9).
  //   - ansible-lint --fix: deponun YAML dosyalarını yerinde DEĞİŞTİRİR → ağaç sessizce kirlenir,
  //     üretilmiş/izli dosyalar (dagit_vars.yml, roller) beyansız değişir.
  //   - ade setup / ADT kurulumu: .venv'e paket kurar → pinli sürümler (pytest-xdist, ansible-lint)
  //     sessizce kayar, tam suite ölçümü kıyaslanamaz hale gelir.
  // Yeniden açmak gerekirse: depo ayarı değil, VS Code KULLANICI ayarı olarak açılsın ve o
  // pencerede dağıtım/suite koşulmasın.
  "ansible.mcpServer.enabled": false,
  "files.associations": {
    "deploy/ansible/**/*.yml": "ansible",
    "research/cards/*.yaml": "yaml",
    "deploy/**/*.yaml": "yaml"
  },
  "yaml.format.enable": false,
  "redhat.telemetry.enabled": false,

  // --- Terraform (hashicorp.terraform) ---------------------------------------------------------
  // CLI `brew install hashicorp/tap/terraform` ile kurulu, A1 ile AYNI sürüm (1.16.2). Editörde
  // biçimlendirme (`terraform fmt`) ve durağan doğrulama çalışır. `validateOnSave` KAPALI kalır:
  // `terraform validate` önce `init` ister ve yerel `init` depo-izli `.terraform.lock.hcl`e macOS
  // özetlerini ekler → kirli ağaç dağıtım kapısını durdurur. Plan/import yalnız A1'de
  // (`altyapi/altyapi.sh`); durum dosyası `/opt/veri/altyapi/apisix/`tedir, yerelde YOK.
  "terraform.languageServer.enable": true,
  "terraform.validation.enableEnhancedValidation": true,
  "terraform.experimentalFeatures.validateOnSave": false,
  "terraform.languageServer.indexing.ignoreDirectoryNames": [
    ".venv", "node_modules", "state", "backups", "research", ".claude"
  ],
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true
  },
  "[terraform-vars]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true
  },

  // --- Docker (ms-azuretools.vscode-containers) ------------------------------------------------
  // YALNIZ dil desteği: Dockerfile + docker-compose.yml tanılamaları/tamamlama. Konteyner KOŞMAZ:
  // compose `worker` servisi kadansı başlatır (MERIDIAN_AUTOSTART_CYCLE=1) — yerelde koşması
  // `./serve.sh` ile aynı çift-emir riskidir (CLAUDE.md §9). Compose A1'in kanonik yolu da değil
  // (dosya şerhi: bayat, geri alınabilirlik için durur). `colima` kurulu ama bilerek kapalı.
  "containers.enableComposeLanguageService": true,
  "containers.images.checkForOutdatedImages": false,

  // --- Git / GitHub: UZAKTAN OKUMA otomatik, YAZMA ASLA -------------------------------------
  // `autofetch` yalnız `git fetch` koşar (yerel ağaca dokunmaz) — "GitHub'da ne değişti"
  // sorusu editörde görünür olur. Ama hiçbir ayar OTOMATİK PUSH/COMMIT açmaz: commit ve push
  // Rol-1'in tur kapanışı kararıdır (CLAUDE.md §8) ve kapıları (tam suite/CI) vardır — editörün
  // "Sync" düğmesi bunları atlatacak bir yola dönüşmemeli. `postCommitCommand: none` bunu çiviler.
  "git.autofetch": true,
  "git.autofetchPeriod": 300,
  "git.postCommitCommand": "none",
  "git.enableSmartCommit": false,
  "git.confirmSync": true,
  "git.pruneOnFetch": true,
  "githubPullRequests.pullBranch": "never"
}
