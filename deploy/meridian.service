# systemd unit — brings the Meridian compose stack back after a maintenance reboot.
# Type=oneshot + RemainAfterExit=yes so the unit "stays active" while docker compose owns the processes.
# Install: sudo cp deploy/meridian.service /etc/systemd/system/ && sudo systemctl enable --now meridian
#
# BAYAT, BİLEREK DURUYOR (K1, 2026-07-30): canlı birim `deploy/oracle-a1/meridian.service`tir
# (docker YOK, doğrudan venv). Bu dosya docker-compose çağının kalıntısıdır ve geri alınabilirlik
# için tutulur. Bulut sır deposu projesini geçiren `Environment=` satırı IaC-K5 (2026-09-07) ile
# DÜŞTÜ: `meridian.secrets` o kanalı artık okumuyor, yani satır hiçbir şey yapmayan ama "ayar
# yapıldı" izlenimi veren ölü bir kabloydu (üstelik `%i` şablon belirteci, şablon OLMAYAN bir
# birimde). Sır zinciri: systemd credential → env → `state/secrets.json`.
[Unit]
Description=Meridian paper-trading worker + dashboard (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/meridian
ExecStart=/usr/bin/docker compose up -d --build
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
