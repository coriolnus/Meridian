# meridian-litestream.service — H9 SQLite defterinin SÜREKLİ ÇOĞALTMASI (WP-H / H10 aşama-1).
#
# NEDEN AYRI BİR BİRİM (mevcut üçünden hiçbirine asılmadı):
#  * `meridian.service`e asmak, worker'ın her restart'ında çoğaltmayı kesmek olurdu — oysa
#    çoğaltmanın DEĞERİ tam olarak worker'ın kötü öldüğü anda başlar. `meridian-barsarchive`in
#    ayrı birim olma gerekçesiyle AYNI sınıf.
#  * `meridian-backup.service`e asmak imkânsız: o `Type=oneshot`, bu uzun-koşan bir daemon.
#  * H3 tur-2 birimleri TAZE (2026-08-02) ve canlıda seccomp nöbeti altında; onlara dokunmak,
#    ölçülmüş bir sertleştirmeyi ölçülmemiş bir değişiklikle karıştırmak olurdu.
#
# NE YAPAR: `litestream replicate` /etc/litestream.yml'i okur, `state/meridian.db`nin WAL'ini
# izler ve değişiklikleri 10sn'de bir `/home/ubuntu/replica/meridian.db` altına yazar.
# TASARIM GEREKÇELERİNİN TAMAMI (RPO, aynı-disk sınırı, snapshot penceresi, litestream'in canlı
# DB'ye YAZDIĞI gerçeği) `deploy/oracle-a1/litestream.yml` başındadır — BURADA TEKRAR EDİLMEZ.
#
# ⚠ ARIZA ŞEKLİ UYARISI (bu birime ÖZGÜ — `meridian-barsarchive` ile AYNI SINIF):
# `OnFailure=` YOK ve `Restart=always` var. `meridian-fail-notify.service` BİLEREK bağlanmadı:
# o birimin gövdesi sabit metinle "meridian.service FAILED" der (dosyasına bakıldı) — buraya
# bağlamak operatöre YANLIŞ BİRİMİ bildiren bir alarm üretirdi, ve yanlış alarm alarmsızlıktan
# beterdir. Sonuç DÜRÜSTÇE YAZILIYOR: bu birim çökerse restart döngüsüne girer ve KİMSE HABER
# ALMAZ. Bu yüzden ölçüsü `is-active` DEĞİLDİR — replica dizinindeki EN YENİ dosyanın YAŞIdır
# (RUNBOOK B4 adım 5c). Bildirim kanalı, alarm metnini birim adından üreten bir fail-notify
# revizyonuyla AYRI bir turda bağlanır (bu turda kapsam dışı, kayda geçti).
#
# Kurulum: `deploy/oracle-a1/litestream_kur.sh` (sürüm-sabitli + sha256 kapılı, İDEMPOTENT).
# `deploy.sh` bu birimi KURMAZ — kurulum litestream ikilisini de gerektirir ve o bir bakım
# penceresi kalemidir (ilk `start` canlı defterin ŞEMASINA iki tablo ekler; litestream.yml'e bak).
[Unit]
Description=Meridian SQLite ledger continuous replication (Litestream -> file replica)
Documentation=file:///opt/meridian/deploy/oracle-a1/litestream.yml
# `After=` SIRA verir, `Requires=` VERMEZ — BİLİNÇLİ: worker durmuşken de çoğaltma sürmelidir
# (bakım penceresinde `systemctl stop meridian` çoğaltmayı DA durdursaydı, pencerede yapılan
# migrasyonun geri sarılabilir noktası olmazdı — H9 penceresinin en riskli anı tam orasıydı).
After=meridian.service
# Ağ YOK: dosya replica'sı yereldir. `network-online.target` BİLEREK yazılmadı — olmayan bir
# bağımlılığı beyan etmek, açılış grafiğini yalan söyleten bir kalemdir. Aşama-2'de (OCI bucket)
# bu satır GERİ GELİR ve o zaman gerçek olur.

[Service]
Type=simple
User=ubuntu
Group=ubuntu
# WorkingDirectory=/opt/meridian YAZILMADI: `uv`/venv yok, tüm yollar config'te MUTLAK. Çalışma
# dizini vermek, o dizinin varlığını gereksiz bir açılış koşuluna çevirirdi.
# Yapılandırma yolu AÇIK yazıldı. Varsayılanla (main_notwindows.go:12 → /etc/litestream.yml) aynı
# ama örtük bırakılmadı: birim dosyasını okuyan mühendis hangi dosyanın yürürlükte olduğunu
# systemd'nin kaynağından okumalı, litestream'in sürüm notlarından değil.
ExecStart=/usr/local/bin/litestream replicate -config /etc/litestream.yml
Restart=always
RestartSec=30
# SIGTERM yeterli: litestream SIGINT/SIGTERM'i yakalar (cmd/litestream/main_notwindows.go:20
# `signal.Notify(ch, syscall.SIGINT, syscall.SIGTERM)`) ve kapanışta bekleyen senkronları
# tamamlamaya çalışır (varsayılan shutdown-sync-timeout 30sn, db.go:40). Bu yüzden aşağıdaki
# TimeoutStopSec o bütçeden BÜYÜK seçildi — systemd, litestream'i son senkronunun ORTASINDA
# öldürürse son işlemler replica'ya hiç geçmez ve "RPO 10 saniye" cümlesi yalan olur.
TimeoutStopSec=45

# ==================================================================================================
# H3 SERTLEŞTİRME — TUR-2 SETİ (2026-08-02'de üç birime uygulanan setle BİREBİR AYNI).
# Kalemlerin TAM gerekçeleri `meridian.service`tedir ve BURADA TEKRAR EDİLMEZ; bu birime ÖZGÜ
# ayrışmalar ADIYLA işaretlidir. Set aynı tutuldu ki "hangi birim neyi taşıyor" sorusu depoda
# cevaplanabilsin (ayrışma testle çivili: tests/test_litestream_v180.py).
# ==================================================================================================
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
# --- AYRIŞMA 1/3 — ReadWritePaths BU BİRİMDE EN DAR OLANI: `/opt/meridian` ağacının TAMAMI DEĞİL,
#     yalnız `state`. Diğer üç birim `uv run` ile başladığı için tüm depo ağacını (venv doğrulaması
#     + __pycache__) açmak zorundaydı; litestream tek statik ikilidir, Python'a hiç dokunmaz.
#  /opt/meridian/state   : ÇOĞALTILAN DEFTERİN KENDİSİ. Salt-okuma YETMEZ — ölçüldü (litestream.yml
#                          başlığı, kaynak satırlarıyla): litestream `PRAGMA journal_mode=wal`
#                          çalıştırır, `_litestream_seq` + `_litestream_lock` tablolarını YARATIR ve
#                          `PRAGMA wal_checkpoint` atar. Ayrıca SQLite `-wal`/`-shm` yan dosyaları
#                          için DİZİN yazma izni ister. Dizinin ÜSTÜ (/opt/meridian) açılmadı:
#                          litestream'in koda, venv'e ya da .env'e işi yok.
#  /home/ubuntu/replica  : replica hedefi (litestream.yml `replica.path`). `ProtectHome=read-only`
#                          bu yolu kapatır; açılmazsa çoğaltma HİÇ başlamaz.
#  /var/lib/litestream   : meta dizini (litestream.yml `meta-path`) — yerel TXID muhasebesi.
#                          `ProtectSystem=strict` /var'ı salt-okuma yapar; bu tek alt ağaç delinir.
#  `-` ÖNEKİ ÜÇÜNDE DE YOK — BİLİNÇLİ: üçü de bu birimin çalışması için ŞARTTIR. Yokluklarında
#  systemd birimi AÇILIŞTA ve GÜRÜLTÜLÜ reddeder ("Failed to set up mount namespacing"). Sessizce
#  çoğaltmasız koşmaktansa açıkça patlaması yeğdir (meridian-backup.service'teki aynı karar).
#  Dizinleri `litestream_kur.sh` kurar (sahiplik ubuntu:ubuntu, 0750).
ReadWritePaths=/opt/meridian/state /home/ubuntu/replica /var/lib/litestream
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# --- AYRIŞMA 2/3 — BU BİRİMİN AĞ İHTİYACI SIFIRDIR (dosya replica'sı; metrik `addr` ayarlanmadı,
#     kontrol soketi kapalı). Liste yine de diğer üç birimle BİREBİR AYNI bırakıldı: ortak
#     direktiflerin ayrışması "hangisi neden farklı" sorusunu bir sonraki turda cevapsız bırakır
#     (aynı gerekçe meridian-barsarchive.service'te de yazılı). Aşama-2'de (S3/OCI bucket)
#     AF_INET zaten GEREKECEK; şimdi daraltıp o turda geri açmak, iki kez ölçmek demekti.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
#
# --- AYRIŞMA 3/3 — SIGSYS BURADA DA SESSİZDİR (OnFailure yok, yukarıdaki uyarı). Go çalışma-zamanı
#     `@system-service` içinde kalır (aynı filtre altında koşan üç Python birimi 2026-08-02'den beri
#     temiz), ama bu bir TAHMİNDİR: ölçüsü RUNBOOK B4 adım 7'deki 24 saat nöbetidir ve o adım bu
#     birim için pazarlığa AÇIK DEĞİLDİR — çünkü çoğaltmanın sessizce durduğu bir gün, ancak
#     restore gerektiğinde fark edilirdi.
# Dışarıda bırakılanlar (MemoryDenyWriteExecute · PrivateDevices · PrivateUsers · ProtectProc/
# ProcSubset · IPAddressDeny · SystemCallErrorNumber=EPERM) ve gerekçeleri: meridian.service.
# EN SON SATIR (H3 sözleşmesi: en riskli kalem dosyanın sonunda durur):
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
