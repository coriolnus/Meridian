# meridian.service — Oracle Cloud Always Free Ampere A1 (aarch64 Linux) için YERLİ systemd birimi.
#
# macOS'taki launchd TCC engelini (~/Documents'tan LaunchAgent bloklanıyordu) çözer: Linux'ta systemd
# sorunsuz çalışır, çöküş/yeniden başlatmada süreci geri getirir — keepalive.sh'a gerek kalmaz.
# Docker YOK: Meridian saf Python + uv, build adımı yok; süreç doğrudan venv'den koşar (ARM'da hafif).
#
# Kurulum (A1'de, aşağıdaki deploy.sh bunu otomatik yapar):
#   sudo cp deploy/oracle-a1/meridian.service /etc/systemd/system/meridian.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now meridian
#   systemctl status meridian   ·   journalctl -u meridian -f
[Unit]
Description=Meridian paper-trading worker + dashboard (native uv/uvicorn)
After=network-online.target
Wants=network-online.target
# SÜREÇ ÖLÜYKEN HABER VEREN TEK KATMAN. `notify.py` bildirimleri süreç İÇİNDEN yazar; Restart=always
# bile kaldıramadığında (bozuk venv, dolu disk, OOM) haber verecek kimse kalmıyordu. Temiz
# `systemctl stop` bunu TETİKLEMEZ — operatörün durdurması bir arıza değildir.
OnFailure=meridian-fail-notify.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/meridian
# --- broker & otomasyon ---
Environment=MERIDIAN_BROKER=alpaca_paper
Environment=MERIDIAN_AUTOSTART_CYCLE=1
Environment=CYCLE_POLL_SECONDS=300
Environment=MERIDIAN_AUTOSTART_HERMES=1
Environment=HERMES_POLL_SECONDS=300
# --- ÇEKİRDEK AYARI (4 OCPU, sunucuda ÖLÇÜLDÜ 2026-07-30: nproc=4 / 12GB). Eski "2 OCPU → havuzu
#     KAPAT" notu ESKİDİ: operatör 4 OCPU'luk instance açabildi. Havuz artık AÇIK ve kendini
#     sınırlıyor — reflect.py:1049 `workers = max(2, min(4, cpu_count-2))` → 4 çekirdekte 2 işçi,
#     geriye sunucu+ajan için 2 çekirdek kalır (yerel prod serve.sh ile aynı bayrak).
#     Duvar-saati tavanı yine geniş: Ampere çekirdeği Apple Silicon'dan yavaş, aramalar uzun sürer. ---
Environment=MERIDIAN_PARALLEL_PROBES=1
Environment=MERIDIAN_SEARCH_MAX_MIN=60
Environment=HERMES_SEARCH_BUDGET=8
# --- PANO TOKEN'I ARTIK BU DOSYADA DEĞİL (H3 tur-1, 2026-07-31 bakım penceresi) --------------
#     `MERIDIAN_DASH_TOKEN` eskiden BURADA düz metin `Environment=` satırıydı; birim dosyası
#     /etc/systemd/system altında 0644'tür — yani makinedeki HER kullanıcı token'ı okuyabiliyordu.
#     Token rotasyona girdi ve 0600'lük `/opt/meridian/.dash.env` kanalına taşındı.
#     `-` öneki: dosya yoksa hata değil (token'sız kurulumda pano açık kalır — tek savunma
#     127.0.0.1 bağıdır, bkz. MERIDIAN_BIND_HOST kapısı aşağıda).
#     DEPO–CANLI AYRIKLIĞI KAPANDI (H3 tur-2, 2026-08-02): bu satır 2026-07-31'de YALNIZ canlı
#     birime `sed` ile eklenmişti (bakim_h9.sh:59), depodaki kopya CHANGEME'li kalmıştı. Depodaki
#     birimi canlıya kopyalayan HER prosedür (deploy.sh:89 dahil) rotasyonu sessizce geri alırdı.
#     Sır DOSYADA taşınır, birimde değil: `.dash.env` `dagit.sh` rsync'inden bilerek dışlanmıştır.
EnvironmentFile=-/opt/meridian/.dash.env
#     KALAN YÜZEY ve TUR-3 HAZIRLIĞI (2026-08-03): bu satır sırrı DOSYADAN çıkarıp SÜREÇ ORTAMINA
#     koyar, ve bu depoda ortam ÇOCUKLARA AKAR (`serve.sh:51` uvicorn'u `env=os.environ` ile,
#     `hermes_composite.py:341` ajan alt süreçlerini devralınan ortamla doğurur) — yani token her
#     LLM alt sürecinin `/proc/<pid>/environ`ında duruyor. Yapısal kapanış systemd
#     `LoadCredential`dır (sır ortama HİÇ girmez). Hazırlık VERSİYONDA, canlıda DEĞİL:
#       meridian.service.d/50-dash-credential.conf  (faz 1: credential kanalını ekler)
#       meridian.service.d/51-dash-env-kaldir.conf  (faz 2: bu satırı etkisizleştirir)
#       dash_token_credential.sh                    (rotasyon + kurulum + farksal doğrulama)
#     BU DOSYAYA `LoadCredential=` YAZILMADI ve yazılmamalı: kaynak dosya (/etc/meridian/dash_token)
#     yokken systemd birimi BAŞLATMAZ, ve `deploy.sh:89` bu birimi her dağıtımda canlıya kopyalar —
#     yani satır burada dururken koşacak İLK dağıtım panoyu düşürürdü. Drop-in'i kuran tek yer
#     bakım penceresinde elle koşan `dash_token_credential.sh --faz1`dir.
# --- BAĞLANMA ADRESİ TEK KAYNAK (denetim C1, 2026-08-02) ---------------------------------------
#     api._auth_posture_check bu değişkeni okur ve loopback DIŞI + parolasız hâlde süreci
#     AÇMAYI REDDEDER. Eskiden ExecStart `--host 127.0.0.1` SABİTİYDİ ve bu değişkeni hiçbir
#     başlatıcı yazmıyordu → kapı YAPISAL olarak ateşlenemiyordu. Artık ExecStart bağ adresini
#     BURADAN alır: değeri değiştiren operatör kapıyı da kurmuş olur. Varsayılan DEĞİŞMEDİ.
#     systemd `${VAR}` genişletmesi değişken bu birimde TANIMLI olduğu için çalışır (tanımsız
#     olsaydı BOŞ dizeye genişler ve uvicorn'u kırardı — o yüzden satır aşağıdaki gibi ZORUNLU).
#     SATIR SONU YORUMU YOK: systemd `Environment=` satırında `#` değerin parçası sayılır.
Environment=MERIDIAN_BIND_HOST=127.0.0.1
# uv PATH'i (deploy.sh uv'yi ~/.local/bin veya ~/.cargo/bin'e kurar)
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/.local/bin/uv run uvicorn meridian.api:app --host ${MERIDIAN_BIND_HOST} --port 8080 --log-level warning
# HER `systemctl restart`/`stop` OnFailure'ı YANLIŞ ATEŞLİYORDU (triyaj Kalem 1, 2026-08-09). systemd
# durdurmada ana sürece SIGTERM yollar; ExecStart'taki ana süreç `uv run`dır ve çocuğu (uvicorn)
# SIGTERM'le ölünce KENDİSİ 143 (128+15) EXIT KODUYLA çıkar — sürecin SIGTERM SİNYALİYLE ölmesi değil.
# Varsayılan SuccessExitStatus SIGTERM/SIGINT/SIGPIPE/SIGHUP SİNYALLERİYLE ölmeyi temiz sayar
# (systemd.service(5)) ama `uv`nin PROPAGE ETTİĞİ 143 EXIT KODUNU saymaz → birim "failed" → yukarıdaki
# OnFailure=meridian-fail-notify HER dağıtımda ateşler. N1 bildirim kanalı açılınca (triyaj operatör-
# sorusu 1) GERÇEK arıza bu gürültüde boğulurdu; kanal AÇILMADAN düzeltilmesi bu yüzden bir KAPI.
# 143'ü yalnız SIGTERM üretir; gerçek çöküş başka kodla (bozuk venv/dolu disk) ya da SIGKILL=137/
# SIGSEGV=139 ile düşer ve OnFailure'a giden yolu KAPATMAZ — bu satır temiz durdurmayı susturur, arızayı DEĞİL.
SuccessExitStatus=143
Restart=always
RestartSec=10
# çöküş sonrası taze-veri çekimiyle healthz ~10dk 503 dönebilir — normal
TimeoutStartSec=0

# ==================================================================================================
# H3 SERTLEŞTİRME — TUR-2 (2026-08-02).  ÖNCEKİ: tur-1 (2026-07-31) aynı seti AYRI bir drop-in
# dosyasından (`sertlestirme.conf`, bakim_h9.sh:56) uyguluyordu ve 9.2 UNSAFE → 6.3 MEDIUM yaptı.
#
# NEDEN ARTIK DROP-IN DEĞİL, BİRİMİN İÇİNDE: drop-in bir SKALER direktifi (ProtectHome, ProtectSystem)
# birim dosyasının üstüne SESSİZCE yazar; `ReadWritePaths` ise BİRİKİR. İki kaynak bir arada olsaydı
# tur-1'in `ProtectHome=read-only`si burada duruyormuş gibi görünürken aslında drop-in'den geliyor
# olurdu ve dosyayı okuyan mühendis yürürlükteki ayarı YANLIŞ okurdu. Sertleştirme TEK yerde okunur.
# → UYGULAMA PROSEDÜRÜ CANLIDAKİ TUR-1 DROP-IN'İNİ SİLER (RUNBOOK "H3 tur-2" bölümü, adım 2).
#   Silinmezse zarar yok ama `systemd-analyze cat-config` iki kaynak gösterir; bu turun amacı o.
# ==================================================================================================
NoNewPrivileges=true
# Süreç zaten User=ubuntu (root DEĞİL) — ama systemd sınırlayıcı kümeyi boş bırakmadıkça `setuid`
# bir ikili çalıştırılırsa kapasiteler geri gelebilirdi. Boş küme = HİÇBİR yetenek. uvicorn 8080
# (>1024) dinliyor, CAP_NET_BIND_SERVICE GEREKMİYOR — ölçüldü: ExecStart --port 8080.
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
# --- ReadWritePaths ENVANTERİ — ÖLÇÜLDÜ (kod tarandı; "olsun diye" hiçbir yol eklenmedi) ---------
#  /opt/meridian  → BÜTÜN AĞAÇ AÇIK, `state/`e DARALTILAMAZ. state DIŞINDA yazılan beş yol var:
#     · logs/composite-prescreen.log  — hermes_composite.py:340-341 ROOT'a yazar (state'e DEĞİL)
#     · skills/<ad>.v2-draft          — skill_evolve.py:169
#     · research/edgar_facts/…csv.gz  — adapters/edgar_shares.py:71 (config.ROOT altı)
#     · .venv/ + uv.lock              — `uv run` HER AÇILIŞTA ortamı doğrular ve gerekirse yazar
#     · */__pycache__/*.pyc           — import ANINDA, kaynak ağacının her yerine
#     (state'in kendisi: store.py:39 → config.STATE · strategy.yaml config.py:176 · SQLite+WAL)
#     Tur-1 de tüm ağacı açmıştı ve canlıda çalıştı — daraltma bu turda ÖLÇÜLMEDİ, denenmedi.
#  /home/ubuntu/.cache  → `uv run` önbelleği. ProtectHome=read-only'yi bilerek deler; ReadWritePaths
#     ProtectHome/ProtectSystem'e ÖNCELİKLİDİR. Yoksa servis BAŞLAMAZ (tur-1'de canlıda ölçüldü).
#  /home/ubuntu/.hermes → TUR-2 DÜZELTMESİ; TUR-1'DE EKSİKTİ VE SESSİZCE KIRIYORDU. Süreç bu dizine
#     YAZAR: hermes.py:1942 `mkstemp(dir=~/.hermes)` + .env 0600 · :1956 meridian-model-backup.json ·
#     :2072 config.yaml.meridian.bak + mkstemp/os.replace · :2215 skills/ mkdir · :2221 symlink
#     kurma/sökme; ayrıca `hermes config set` alt süreci kendi config.yaml/auth.json'ını yazar.
#     KIRILGANLIK SINIFI: bu yazımların HEPSİ `except OSError: pass` / `except Exception` altında —
#     read-only kök altında hata GÖRÜNMEDEN yutulur, `sync_agent_skills` sessiz no-op'a döner.
#     Yani tur-1 sonrası "ajan skill'leri eşitlendi" satırı YAZILMIYOR olabilir; RUNBOOK'un
#     doğrulama adımı (hermes yazma probu) tam olarak bunu ölçer.
#     `-` ÖNEKİ ZORUNLU ve ölçülmüş bir riske karşıdır: RUNBOOK Bölüm D'ye göre hermes-agent
#     installer'ı DÜŞEBİLİR ve kurulum buna rağmen DEVAM EDER — yani `~/.hermes` OLMAYABİLİR.
#     Öneksiz yazılsaydı systemd birimi "Failed to set up mount namespacing" ile REDDEDERDİ:
#     ajanı olmayan bir kurulumda WORKER HİÇ AÇILMAZDI. Ajan Meridian'ın çalışması için şart
#     değildir (ajansız deterministik öneriye düşer) — o yüzden yokluğu birimi öldürmemeli.
#     Dizin yoksa yol sessizce atlanır ve durum tur-1'dekiyle AYNI kalır; RUNBOOK adım 2 dizinin
#     varlığını AÇIKÇA yoklar ve adım 5(b) probu kırıklığı `HERMES-RW-KIRIK` diye adlandırır.
ReadWritePaths=/opt/meridian /home/ubuntu/.cache -/home/ubuntu/.hermes
# hermes_composite.py:330 `/tmp/prescreen-<id>` kullanıyor; PrivateTmp bunu KIRMAZ (özel ad alanı
# yazılabilir) ama operatör SSH kabuğundan o dizini GÖREMEZ — RUNBOOK'ta nasıl bakılacağı yazılı.
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
# Kodda ve bağımlılık ağacında ad-alanı çağrısı YOK (grep: unshare/setns/nsenter/bwrap/chroot →
# 0 isabet); alt süreçler düz fork/exec. CLONE_NEWUSER'ı kapatmak en ağır tek maruziyet kalemidir.
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# AF_NETLINK BİLEREK YOK: glibc getaddrinfo kaynak-adres seçimi için netlink açmayı DENER ve
# başarısızlıkta düşer. Bu bir varsayım değil — tur-1 bu tam listeyle 2026-07-31'den beri canlıda
# ve Alpaca/Anthropic dışa çağrıları çalışıyor. Redis 127.0.0.1:6379 (AF_INET), alt süreç
# boruları/uvicorn sinyal çifti (AF_UNIX).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# aarch64 tek mimari; 32-bit uyumluluk ikilisi yok (uv/python native arm64). Bu satır olmadan
# seccomp filtresi başka bir ABI üzerinden dolaşılabilir.
SystemCallArchitectures=native
#
# --- BİLİNÇLİ OLARAK DIŞARIDA BIRAKILANLAR (her biri gerekçeli — ölçülmeden eklenmez) ------------
# MemoryDenyWriteExecute : ÖLÇÜLEMEDİ, o yüzden YOK. Bizim kodda ctypes/cffi yok (grep: 0 isabet)
#   ama bağımlılık ağacı üçüncü parti (numpy/pandas/grpc/anthropic) ve CPython `uuid` gibi stdlib
#   modülleri koşula bağlı `ctypes` yükler; libffi trampolini W+X ister. ASIL SEBEP ARIZA ŞEKLİ:
#   ihlal AÇILIŞTA değil, o kod yoluna İLK GİRİLDİĞİNDE SIGSYS ile öldürür — yani aşağıdaki
#   "başlat + healthz" doğrulaması bunu YAKALAYAMAZ. Tur-3 kalemi: 24 saat canlı gözlemle ölç.
# PrivateDevices          : /dev kullanımı kodda yok (grep: 0 isabet) ama reflect.py:1059 süreç
#   havuzu multiprocessing semaforları için /dev/shm ister; PrivateDevices'ın verdiği /dev/shm
#   ÖZELdir ve havuz–ebeveyn eşleşmesi bu turda ölçülmedi. Tur-3 kalemi.
# PrivateUsers / ProtectProc=invisible / ProcSubset=pid : ProcSubset /proc/meminfo,cpuinfo,stat'ı
#   gizler; os.cpu_count() (reflect.py:1059, sprint.py:290) sysconf üzerinden okur ve bunun
#   aarch64/glibc'de /sys mi /proc mu kullandığı ÖLÇÜLMEDİ. Yanlışsa işçi sayısı sessizce 2'ye
#   düşer — sessiz bozulma sınıfı. Tur-3 kalemi.
# IPAddressDeny/IPAddressAllow : Alpaca/FMP/Anthropic/Nous uç noktalarının IP kümesi SABİT DEĞİL
#   (CDN arkası). Bir allowlist bugün çalışıp yarın veri akışını kesebilirdi.
# SystemCallErrorNumber=EPERM : BİLEREK YOK. EPERM engellenen çağrıyı sıradan bir OSError'a
#   çevirirdi ve bu depoda o hatalar yer yer `except OSError: pass` ile yutuluyor → seccomp
#   engeli SESSİZ veri kaybına dönerdi. Varsayılan davranış (SIGSYS ile öldür) GÜRÜLTÜLÜDÜR:
#   Restart=always yeniden başlatır, OnFailure=meridian-fail-notify operatöre haber verir ve
#   journal "killed by SIGSYS" yazar. Gürültü, sessizlikten iyidir.
#
# EN SON SATIR — seccomp. @system-service dışladıkları: @clock @cpu-emulation @debug @keyring(kısmi)
# @module @mount @obsolete @privileged @raw-io @reboot @swap. Bunların hiçbiri Meridian'ın yolunda
# ölçülmedi; yine de bir kaçırma ihtimali VAR ve arıza şekli SIGSYS'tir (yukarıya bkz.).
# ŞÜPHE HÂLİNDE LOG MODU (öldürmeden ölçmek): bu satırı GEÇİCİ OLARAK kaldır ve yerine
#   SystemCallLog=@clock @cpu-emulation @debug @module @mount @obsolete @privileged @raw-io @reboot @swap
# koy — @system-service'in DIŞLADIKLARINDAN hangisinin gerçekten çağrıldığı journal'a düşer,
# süreç ÖLMEZ. (`SystemCallLog=@system-service` YANLIŞTIR: listelenen çağrılar loglanır, yani
# izin verilen HER çağrıyı yazar — kullanılamaz gürültü.) Komut RUNBOOK'ta.
# UYGULAMA PROSEDÜRÜ İLK 24 SAAT JOURNAL İZLEMEYİ ŞART KOŞAR.
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
