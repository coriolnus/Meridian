// Pano birim anahtarı (TSK-098, 2026-09-02) — meridian.service içindeki API (ubuntu,
// NoNewPrivileges=true → sudo yolu kapalı, 50-meridian-sprint.rules gerekçesi aynen) panodan
// YALNIZ iki birimi açıp kapatabilsin: `systemctl enable|disable --now <birim>`.
//
// NEDEN ÜÇ EYLEM: `enable/disable` DBus'ta manage-unit-files'a düşer; `--now`un start/stop'u
// manage-units'a; ve systemctl enable/disable işlemin sonunda Manager.Reload çağırır — o da
// reload-daemon'a. Üçünden biri eksikse uç 502 + polkit stderr döndürür (sessiz arıza değil,
// uç öyle tasarlandı).
//
// KAPSAM İKİ KATMANLI — ve iki eylem AYNI DARLIKTA BAĞLANAMAZ (ölçüldü, vaka 2026-09-02
// ilk canlı deneme): systemd `manage-unit-files` eyleminde polkit'e HİÇBİR AYRINTI VERMEZ — ne
// `unit` ne `verb` (systemd v255 kaynağı: unit-file ve reload-daemon denetimleri ayrıntısız çağrılır;
// ilk sürümün `action.lookup("unit")` beklentisi orada hep null kaldı ve varsayılan politika
// "Interactive authentication required" ile reddetti). [2026-10-02 DÜZELTME (TSK-265 güvenlik
// incelemesi): bu paragraf önceden "ayrıntı yalnız verb taşır" diyordu — yanlıştı.]
//   * manage-units: TAM AD eşleşmesi + FİİL süzgeci, yalnız start|stop (TSK-265 düzeltme turu 1, M4).
//     Fiiller ÖLÇÜLDÜ: anahtar `enable --now` → StartUnit (verb start), `disable --now` → StopUnit
//     (verb stop); öğrenme düğmesi `systemctl start|stop meridian-learn.service`; sprint durdurma
//     `stop --no-block` (verb yine stop). set-property / kill / clean / freeze / restart DIŞARIDA.
//     Beyaz liste api.py `BIRIM_ANAHTAR_BEYAZ` ile EL İLE eşit tutulur (iki dil/iki makine: türetme
//     kurulamaz; ayrışma çivisi tests/test_birim_anahtari_v368.py::test_polkit_kurali_BEYAZ_LISTEYLE_AYRISMAZ).
//   * manage-unit-files (enable/disable): birim ve fiil ayrıntısı YOK → eşleşme yalnız eylem
//     kimliğiyle; ubuntu'ya TÜM unit-file fiilleri açılır (link/mask/preset/add-wants/set-default dahil).
//     [2026-10-02 DÜZELTME (güvenlik incelemesi C2): eski metin "mask/link/preset DIŞARIDA", "birim
//     dosyası YAZMAK yine root ister" ve "en kötü durum: mevcut birimleri aç/kapat" diyordu — ÜÇÜ DE
//     YANLIŞ. `link` bir birim dosyasını unit dizinlerine YAZMADAN ubuntu ağacından bağlar; sonuç
//     ANINDA ROOT'tur (aşağıda TSK-265 R2).]
//   * reload-daemon: ayrıntı taşımaz; link'lenen dosyayı systemd'ye okutan halkadır (C2 zinciri).
//
// TSK-265 R2 (2026-10-02) — DARALTMA ÖLÇÜLDÜ, BU KATMANDA YAPILAMAZ: Rol-1 "manage-unit-files'ı
// adlı birimlere daralt" dedi. Yukarıdaki ölçüm (bu eylemde unit/verb ayrıntısı GELMEZ) birim adıyla
// süzgeci imkânsız kılar — uydurma bir `unit ==` şartı hiç eşleşmez ve anahtarı kesin olarak kırar.
// Tehdit ANINDA ROOT'tur (güvenlik incelemesi C2; bu paragrafın "sonraki açılışta" diyen ilk sürümü
// yanlıştı). Tek meşru kullanıcı API birim anahtarıdır, ama yetki HER ubuntu sürecinindir:
//   (1) /opt/meridian altına `User=`'sız bir birim yazılır, `[Install] WantedBy=meridian-learn.service`;
//   (2) DBus'ta LinkUnitFiles + EnableUnitFiles (bu dosyanın manage-unit-files YES'i) ve Reload
//       (reload-daemon YES);
//   (3) izinli `start meridian-learn` (manage-units YES) → kötü birim Wants= bağımlılığı olarak AYRI
//       yetki sorulmadan ROOT başlar. Aynı zincir `add-wants meridian.service` + 52 restart ile de kurulur.
// İki YES depo geneli sınıf çivisinde BEYANLI istisnadır (tests/test_root_yurutur_ubuntu_yazar_v614.py,
// POLKIT_BEYANI, kalem TSK-266); kapanış TSK-266'da (root sahipli sabit-komutlu şablon birim ya da
// bayrak dosyası + start/stop), bu dilimin kapsamı dışında.
//
// DENETİM İZİ (YASA 6): her YES kararı polkit.log ile journal'a düşer (okuyucu: birim
// anahtarı denemelerinin canlı doğrulaması — bu vaka journal'da ayrıntı yokluğundan
// kör kalmıştı, iz o körlüğü kapatır).
polkit.addRule(function(action, subject) {
    if (subject.user != "ubuntu") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id == "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if ((unit == "meridian-learn.service" ||
             unit == "meridian-barsarchive.service") &&
            (verb == "start" || verb == "stop")) {
            polkit.log("meridian-birim-anahtari: manage-units verb=" +
                       action.lookup("verb") + " unit=" + unit + " -> YES");
            return polkit.Result.YES;
        }
    }
    if (action.id == "org.freedesktop.systemd1.manage-unit-files") {
        // FİİL KONTROLÜ DE YOK — ölçüldü (vaka 2026-09-02, ikinci tur): bu eylemde polkit'e
        // NE unit NE verb ayrıntısı iniyor (pkcheck detaysız sorgusu da challenge aldı;
        // verb=="enable|disable" şartlı ilk düzeltme de aynı "Interactive authentication
        // required" ile düştü). Eşleşme eylem kimliğiyledir. BEDEL BÜYÜDÜ ve BEYANLI:
        // ubuntu'ya TÜM unit-file fiilleri açılır (mask/link/preset dahil). Birim-düzeyi
        // darlık API beyaz listesinde (v368), etkileşimli ubuntu zaten parolasız sudo.
        // [2026-10-02 DÜZELTME: burada "birim dosyası YAZMAK yine root ister" yazıyordu — YANLIŞ,
        // `link` yazmadan bağlar; şiddet yukarıda TSK-265 R2.] polkit.log bu polkitd yapısında (v124,
        // duktape) SESSİZCE KAYBOLUYOR — ölçüldü: stop'un YES'i dahil hiçbir iz journal'a
        // düşmedi; satırlar gelecekteki bir motorda dirilir diye kalıyor, DENETİM İZİ
        // OLARAK GÜVENİLMEZ (gerçek iz: api.py birim_istek obs kaydı).
        polkit.log("meridian-birim-anahtari: manage-unit-files -> YES");
        return polkit.Result.YES;
    }
    if (action.id == "org.freedesktop.systemd1.reload-daemon") {
        return polkit.Result.YES;
    }
});
