# meridian-grafana.service — gecikme ZAMAN SERİSİNİN kanonik yüzeyi (TSK-020 UYGULA-9 Faz A).
# Tasarım: docs/TASARIM-TELEMETRI-PROMETHEUS-2026-09-28.md (T1/T5/T7). Pano ANLIK durumu göstermeye devam eder;
# geçmiş burada (tek-kaynak beyanı RUNBOOK'ta). Erişim YALNIZ ssh tüneli:
#   ssh -i ~/.ssh/oci-a1.key -N -L 3000:127.0.0.1:3000 ubuntu@130.61.126.87   → http://localhost:3000
#
# DİNLEME 127.0.0.1:3000 (`GF_SERVER_HTTP_ADDR` boş kalsaydı Grafana TÜM arayüzlere bağlanırdı — varsayılan).
# Anonim erişim · kayıt · birleşik uyarı KAPALI (ikinci alarm kanalı yasağı, tasarım §2). Dış çağrılar (kullanım
# istatistiği, sürüm/eklenti denetimi, haber akışı) KAPALI: loopback bir gözlem aracı dışarıya konuşmaz.
#
# İMAJ PİNLİ: grafana/grafana 13.2.2 (OSS imajı; `grafana-oss` deposu artık güncellenmiyor) — GitHub
# `releases/latest` (2026-09-15) + Docker Hub; liste özeti iki kaynaktan ölçüldü ve AYNI (2026-09-28).
# Konteyner imajın kendi kullanıcısıyla koşar (472, imaj yapılandırması `User: 472`); veri dizini A0'da o
# kimliğe ait kurulur.
#
# YÖNETİCİ PAROLASI — DEĞER HİÇBİR SATIRDA YOK (v554 argv sınıfı): Grafana `GF_SECURITY_ADMIN_PASSWORD__FILE`
# ile DOSYADAN okur (imajın `/run.sh`i `__FILE` değişkenlerini dosya içeriğine çevirir — 13.2.2 kaynağı).
# Zincir: Vault → Agent render `/etc/meridian/grafana_admin_parola` (0400 root) → drop-in `LoadCredential=`
# (50-grafana-credential.conf) → boşluk kapısı + tmpfs kopya `/run/meridian-grafana/` (0400, sahibi 472;
# LoadCredential dosyası root'a aittir ve 472 onu OKUYAMAZ) → salt-okur `--mount` → `__FILE` yolu.
# Kopya `RuntimeDirectory` tmpfs'indedir: diske inmez, birim durunca systemd siler.
# `--mount` FAIL-CLOSED'dır: kopya yoksa docker DÜŞER. `-v` ise eksik kaynağı DİZİN olarak yaratırdı; Grafana o
# "dosyayı" boş okur ve boş ortam değişkeni varsayılana (admin/admin) düşerdi.
# DİKKAT — İLK AÇILIŞ SEMANTİĞİ: Grafana bu değeri YALNIZ veritabanı ilk kez kurulurken yönetici hesabına yazar.
# Sonraki değişiklik (Vault'ta döndürme) hesabı DEĞİŞTİRMEZ; döndürme reçetesi RUNBOOK'ta (grafana cli).
#
# BELLEK TAVANI İKİ KATMANDA (MemoryMax istemciyi, `--memory` konteyneri sınırlar — meridian-prometheus şerhi).
# KURULUM: A0 rolü KOPYALAR, ETKİNLEŞTİRMEZ; parola Vault'a konmadan birim AÇILAMAZ (LoadCredential kaynağı yok →
# systemd başlatmaz). Elle başlat + test-ateşle (CLAUDE.md §9).
[Unit]
Description=Meridian telemetri — Grafana (yalnız 127.0.0.1:3000; ssh tüneli)
After=docker.service meridian-prometheus.service
Requires=docker.service

[Service]
Type=simple
RuntimeDirectory=meridian-grafana
RuntimeDirectoryMode=0700
ExecStartPre=-/usr/bin/docker rm -f meridian-grafana
ExecStart=/usr/bin/docker run --rm --name meridian-grafana --network host \
  --memory=256m \
  -e GF_SERVER_HTTP_ADDR=127.0.0.1 \
  -e GF_SERVER_HTTP_PORT=3000 \
  -e GF_AUTH_ANONYMOUS_ENABLED=false \
  -e GF_USERS_ALLOW_SIGN_UP=false \
  -e GF_UNIFIED_ALERTING_ENABLED=false \
  -e GF_ANALYTICS_REPORTING_ENABLED=false \
  -e GF_ANALYTICS_CHECK_FOR_UPDATES=false \
  -e GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false \
  -e GF_NEWS_NEWS_FEED_ENABLED=false \
  -e GF_SECURITY_ADMIN_PASSWORD__FILE=/run/secrets/grafana_admin_parola \
  --mount type=bind,source=/run/meridian-grafana/grafana_admin_parola,target=/run/secrets/grafana_admin_parola,readonly \
  --mount type=bind,source=/etc/meridian-telemetri/grafana/provisioning,target=/etc/grafana/provisioning,readonly \
  --mount type=bind,source=/etc/meridian-telemetri/grafana/panolar,target=/etc/grafana/panolar,readonly \
  --mount type=bind,source=/var/lib/meridian-telemetri/grafana,target=/var/lib/grafana \
  grafana/grafana:13.2.2@sha256:ac461fb352abc50da10a51c7d02462e9c05488f11f53f14b3ad79a8145f638a0
ExecStop=/usr/bin/docker stop meridian-grafana
Restart=on-failure
RestartSec=5
MemoryMax=256M

[Install]
WantedBy=multi-user.target
