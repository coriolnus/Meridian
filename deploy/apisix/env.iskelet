# deploy/apisix/env.iskelet — /opt/apisix/.env-apisix'in SIRSIZ aynası (F9-DIŞI sır dosyası).
# Gerçek değerler A1-İÇİNDE üretilir/kopyalanır (openssl rand; bağlama/repoya GİRMEZ), 0600.
APISIX_ADMIN_KEY=<A1-icinde-uret: openssl rand -hex 32>
# Faz-1 LLM rotası: OpenRouter anahtarı $ENV çözümüyle rota konfigurasyonuna girer
# (rotada $ENV://OPENROUTER_API_KEY — anahtar etcd'ye DEĞERİYLE YAZILMAZ).
OPENROUTER_API_KEY=<A1-icindeki-mevcut-.env'den-kopya>
