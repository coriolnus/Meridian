# Caddyfile — Meridian panosu için TLS sonlandıran ters vekil.
#
# NEDEN CADDY: Let's Encrypt sertifikasını kendisi alır ve yeniler, HTTP→HTTPS yönlendirmesi
# varsayılandır, ve yapılandırma bu dosya kadardır. nginx de olur ama sertifika yenileme ayrı bir
# certbot zamanlayıcısı ister; tek operatörlü bir kurulumda unutulacak parça tam olarak odur.
#
# TEMEL KURAL: uvicorn 127.0.0.1'de KALIR. Vekil aynı makinede olduğu için loopback yeterlidir ve
# pano internete DOĞRUDAN hiç açılmaz. `--host 0.0.0.0` vermeye gerek yoktur; verilirse zaten
# api.py parola kurulu değilse açılmayı reddeder.
#
# KURULUM
#   1. DNS: alan adının A kaydı Oracle VM'in genel IP'sine baksın (sertifika bunu doğrular).
#   2. Oracle Security List / NSG: 80 ve 443 açık, DİĞER HER ŞEY KAPALI. 8080'i ASLA açma.
#   3. VM'de yerel güvenlik duvarı da aynısını söylesin (Oracle imajları iptables ile gelir):
#        sudo iptables -I INPUT -p tcp --dport 80  -j ACCEPT
#        sudo iptables -I INPUT -p tcp --dport 443 -j ACCEPT
#        sudo netfilter-persistent save
#   4. `sudo caddy run --config /etc/caddy/Caddyfile` (ya da systemd servisi)
#
# ALAN ADI YOKSA: Caddy IP için Let's Encrypt sertifikası ALAMAZ. O durumda ya bir alan adı al
# (yılda birkaç dolar) ya da `tls internal` kullan — o zaman tarayıcı uyarı verir ve uyarıyı
# tıklayıp geçmek, ortadaki adam saldırısını fark etme yeteneğini kalıcı olarak kaybettirir.
# Broker denetim yüzeyi için tavsiye: alan adı al.

meridian.ORNEK-ALAN-ADIN.com {
	# --- TLS: Caddy otomatik alır/yeniler. E-posta yenileme uyarıları için. ---
	tls senin@eposta.com

	# --- Güvenlik başlıkları ---
	header {
		# HSTS: tarayıcı bu alan adına bir daha ASLA http ile gitmesin. preload YOK —
		# preload listesine girmek geri alınamaz ve tek operatörlü bir kurulumda gereksiz risk.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# ---- CSP ----
		# `script-src 'self'` — ve bu artık GERÇEKTEN karşılanıyor. Bir önceki hâlinde de öyle
		# yazıyordu ama karşılanmıyordu; o CSP dağıtılsaydı pano çizilir, hiçbir düğme iş
		# görmezdi. İki ayrı arıza vardı, ikisi de 2026-08-01'de kapatıldı:
		#
		#   1. landing.html + workflow.html satır içi <script> taşıyordu (workflow'un TÜM
		#      diyagramı o blokta üretiliyor → sayfa bomboş açılırdı).
		#      → landing.js / workflow.js olarak dışarı alındı.
		#   2. app.js'te 34 + index.html'de 6 = 40 SATIR İÇİ OLAY ÖZNİTELİĞİ (onclick/oninput).
		#      CSP bunları da bloklar — <script> blokları kadar. Gezinme, çekmece, KRİZ grubu
		#      ve HALT ölü olurdu.
		#      → hepsi olay delegasyonuna çevrildi: tek document dinleyicisi, `data-act` adını
		#        KAYITLI bir izin listesinde çözer (window[ad] DEĞİL — aksi hâlde DOM'a data-act
		#        sokabilen herkes sayfadaki her globali çağırabilirdi).
		#
		# DOĞRULANDI, varsayılmadı: canlı DOM'da 0 satır içi öznitelik; 33 kayıt ↔ 33 kullanım
		# tam eşleşme; her kayıtlı ad tanımlı; HALT, dört KRİZ kolu, gezinme, tema ve çıkış
		# tarayıcıda tek tek tıklanıp fonksiyona ulaştığı görüldü. eval / new Function /
		# javascript: / dizgi-argümanlı setTimeout: hiçbiri yok.
		#
		# BU SATIRA `'unsafe-inline'` GERİ EKLEME. Eklemek zorunda kaldıysan bir yere satır içi
		# onclick geri gelmiş demektir; çözüm eylemi EYLEMLER kümesine kaydetmek.
		#
		# style-src'deki `unsafe-inline` AYRI ve hâlâ açık bir borç: app.js DOM'u satır içi
		# stil taşıyan şablon dizgileriyle üretiyor, kaldırmak app.js'in yeniden yazılması demek.
		#
		# ---- İKİ DIŞ HOST DÜŞTÜ (D4, 2026-08-07) — SERTLEŞTİRME, MALİYET DEĞİL ----
		# ÖNCE:  style-src 'self' 'unsafe-inline' https://fonts.googleapis.com
		#        font-src  'self' https://fonts.gstatic.com
		# SONRA: style-src 'self' 'unsafe-inline'
		#        font-src  'self'
		# NEDEN VARDILAR: üç yüzey de Geist'i Google Fonts CDN'inden çekiyordu, ve CSP tam olarak
		# bunu barındırmak için genişletilmişti. Yani `docs/TASARIM-YONU-2026-08-07.md` §5'in
		# "CSP dış font-host'a izin vermez" cümlesi BEYANDI, ölçüm değil — ihlal ediliyordu.
		# NEDEN GİTTİLER: yazı tipi değişti (Geist emekli, Recursive Sans/Mono Linear, SIL OFL 1.1)
		# ve yenisi KENDİ-BARINDIRILIYOR: `meridian/web/fonts/*.woff2`, toplam 79,3 KB, aynı origin.
		# KAZANÇ ölçülebilir ve yalnız gizlilik değil: her açılışta iki ek DNS + iki TLS el sıkışması
		# + render-blocking bir CSS isteği ölür; üçüncü bir tarafın panoya kod/font enjekte
		# edebileceği yüzey ortadan kalkar; ve pano ağ kısıtlı bir ortamda (SSH tüneli, kapalı
		# çıkış) DOĞRU YÜZLE açılır — eskiden CDN'e ulaşamayınca sistem yüzüne düşerdi.
		# BU İKİ HOST'U GERİ EKLEME. Eklemek zorunda kaldıysan bir yere `<link>`li bir CDN yazı
		# tipi geri gelmiş demektir; çözüm başlığı gevşetmek değil, dosyayı `meridian/web/fonts/`
		# altına koymak ve `@font-face`i yerel yolla yazmak. Çivi: tests/test_yazitipi_v201.py.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

		# Tıklama hırsızlığı: HALT ve Flatten tek tıkla iş gören düğmeler. Görünmez bir iframe
		# içinde başka bir sayfaya gömülmeleri gerçek bir senaryo.
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"

		# Referrer: URL'lerde artık sır yok (?token= kaldırıldı) ama yol adları da bilgi taşır.
		Referrer-Policy "no-referrer"

		# Tarayıcı yetenekleri: panonun hiçbirine ihtiyacı yok.
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

		# Sunucu parmak izini azalt
		-Server
	}

	# --- Giriş ucuna ek hız sınırı (savunma derinliği) ---
	# api.auth zaten IP başına 15 dk'da 8 deneme sınırı uyguluyor. Bu katman onu TEKRARLAMIYOR;
	# uygulamaya hiç ulaşmadan eleyerek scrypt maliyetini (~120 ms/deneme) saldırgana yüklemekten
	# kurtarıyor — yoksa kaba kuvvet, kilide takılsa bile CPU'yu meşgul eden bir DoS'a dönüşür.
	# NOT: rate_limit Caddy'nin standart dağıtımında YOKTUR, `xcaddy` ile eklenti gerekir.
	# Eklenti kurmak istemiyorsan bu bloğu sil — uygulama sınırı yine de çalışır.
	# @login path /api/login /api/setup-password
	# rate_limit @login {
	# 	zone login { key {remote_host} events 10 window 5m }
	# }

	# --- Vekil ---
	reverse_proxy 127.0.0.1:8080 {
		# api._secure_cookie ve _client_ip bu iki başlığı okur: ilki çerezin Secure
		# işaretlenmesini, ikincisi hız sınırının doğru IP'yi görmesini sağlar.
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
	}

	# --- Loglar ---
	log {
		output file /var/log/caddy/meridian.log {
			roll_size 10mb
			roll_keep 5
		}
		# URL'lerde sır yok ama yine de sorgu dizesini yazma — ileride biri ?token= benzeri
		# bir şey eklerse log sessizce sır biriktirmeye başlamasın.
		format json
	}
}
