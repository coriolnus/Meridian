# Hindsight API — A1 systemd birimi (kart: EDG-2026-065, reçete: docs/INCELEME-HINDSIGHT-DERIN-2026-08-31.md adım 8)
# Kurulum: sudo cp -> /etc/systemd/system/hindsight-api.service && sudo systemctl daemon-reload && sudo systemctl enable --now hindsight-api
# ESKİZDEN SAPMA (2026-08-31): User=hindsight değil User=ubuntu — BLOK-1 yalnız DB ROLÜ açtı, OS kullanıcısı yok;
# /opt/hindsight ubuntu sahipli (kanıt: ls -ld, 16:34Z). Sır dosyası .env chmod 600 ubuntu ile korunur.
# Model önbellekleri ProtectHome=true yüzünden ev dizinine GİDEMEZ — .env HF_HOME'u /opt/hindsight altına yönlendirir.

[Unit]
Description=Hindsight agent memory API
After=network-online.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=ubuntu
EnvironmentFile=/opt/hindsight/.env
# ExecStart SARMALAYICIDIR (TSK-064 YOL-1 Faz-1A, 2026-09-07). Gerçek ikili sarmalayıcının
# SON satırında `exec` edilir; arada yapılan tek iş, `$CREDENTIALS_DIRECTORY` altındaki üç sır
# dosyasını hindsight-api'nin ortamına koymaktır (üçüncü parti süreç, sırrı ortamdan okur —
# B sınıfı YARIM kazanım, gerekçesi `hindsight-api.service.d/50-creds.conf` şerhinde).
# EnvironmentFile YUKARIDA KALIYOR ve bu bilinçli: faz-1'de iki kanal aynı anda canlıdır,
# credential dosyası olmayan ad için ortam değeri OLDUĞU GİBİ geçerlidir. Faz-2'de `.env`ten
# yalnız 3 SIR satırı çıkar, 29 ayar satırı kalır (boş `EnvironmentFile=` sıfırlaması
# KULLANILAMAZ — dosya sır dışında yapılandırma da taşır).
# SIRA: sarmalayıcı `/opt/meridian` altındadır ve depo dağıtımıyla gelir. Bu birim, depo
# dağıtılmadan kurulursa `203/EXEC` ile ölür — önce `dagit.sh`, sonra birim kurulumu.
ExecStart=/opt/meridian/deploy/hindsight/hindsight-api-baslat.sh
Restart=on-failure
RestartSec=5
# kaynak çiti — A1'i koru (24 GB sonrası revizyon: 3G->8G; şişerse Meridian değil Hindsight ölür)
MemoryMax=12G
# 2026-09-02 gece: 14:30 UTC cgroup OOM (anon-rss 8,37 GB > 8G) dev belge retain'inde — makine 23 GB,
# kalan tüketiciler ~3 GB → tavan 12G (ingest 00:10Z öncesi; Rol-1, operatör gece yetkisi).
CPUQuota=200%
# sertleştirme
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hindsight

[Install]
WantedBy=multi-user.target
