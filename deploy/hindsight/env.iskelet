# /opt/hindsight/.env İSKELETİ — gerçek dosya YALNIZ A1'de, chmod 600 (sır taşır, repoya girmez).
# Kaynak: docs/INCELEME-HINDSIGHT-DERIN-2026-08-31.md adım 7 (kart EDG-2026-065 kurulum_sozlesmesi).
# <SIR> alanlarını OPERATÖR doldurur — Rol-1'e söylenmez, hiçbir log/karta yazılmaz.

# --- veritabanı ---
# sslmode=disable ŞART (vaka 2026-08-31): birim ProtectHome=true iken asyncpg'nin varsayılan
# sslmode=prefer'i ~/.postgresql/postgresql.key yoklaması PermissionError ile başlatmayı öldürür.
HINDSIGHT_API_DATABASE_URL=postgresql://hindsight:<SIR>@127.0.0.1:5432/hindsight?sslmode=disable
HINDSIGHT_API_RUN_MIGRATIONS_ON_STARTUP=true
HINDSIGHT_API_DB_POOL_MIN_SIZE=2
HINDSIGHT_API_DB_POOL_MAX_SIZE=10          # varsayılan 100 — A1 için fazla

# --- LLM: dışarı giden TEK trafik (retain/reflect; recall LLM'siz-lokal) ---
HINDSIGHT_API_LLM_PROVIDER=openrouter
HINDSIGHT_API_LLM_API_KEY=<SIR>
HINDSIGHT_API_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free  # 2026-08-31 operatör: ücretsiz NVIDIA; filo botlarıyla AYNI model; çıktı tavanı 65536 (≥65k şartı), 1M bağlam
HINDSIGHT_API_LLM_MAX_CONCURRENT=6          # varsayılan 32 — 4 çekirdek için fazla
HINDSIGHT_API_REFLECT_MAX_COMPLETION_TOKENS=16000

# --- embedding: TAM LOKAL, çok dilli, torch'suz (varsayılan model multilingual-e5-small) ---
HINDSIGHT_API_EMBEDDINGS_PROVIDER=onnx

# --- BM25 dil ayarı: KANIT ÖLÇÜLDÜ 2026-08-31 — A1 PG17'de \dF turkish VAR (kartın kill maddesi kapandı) ---
HINDSIGHT_API_TEXT_SEARCH_EXTENSION_NATIVE_LANGUAGE=turkish

# --- rerank: TAM LOKAL, çok dilli, ONNX + fail-open ---
HINDSIGHT_API_RERANKER_PROVIDER=flashrank
HINDSIGHT_API_RERANKER_FLASHRANK_MODEL=ms-marco-MultiBERT-L-12
HINDSIGHT_API_RERANKER_FLASHRANK_CPU_MEM_ARENA=false
HINDSIGHT_API_RERANKER_1_PROVIDER=rrf       # zincir sonu emniyet supabı

# --- model önbellekleri: birim ProtectHome=true — ev dizini KAPALI, /opt/hindsight altına yönlendir ---
HF_HOME=/opt/hindsight/hf-cache
HINDSIGHT_API_RERANKER_FLASHRANK_CACHE_DIR=/opt/hindsight/flashrank-cache

# --- worker kimliği: docs "üretimde sabitle" ---
HINDSIGHT_API_WORKER_ID=a1-worker-1
