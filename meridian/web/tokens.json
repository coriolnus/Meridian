      },
      "display": {
        "$description": "Başlık ailesi = gövde ailesi. Dekoratif display yüzü BİLEREK yok; kişilik rakamlarda.",
        "$extensions": {
          "org.meridian.css": {
            "var": "--display",
            "literal": "var(--sans)"
          }
        },
        "$value": "{temel.tipografi.sans}"
      },
      "serif": {
        "$description": "Sözleşme artığı: hiçbir kural okumuyor (ölçüldü: 0 kullanım). Kaldırılması ayrı bir tur.",
        "$extensions": {
          "org.meridian.css": {
            "var": "--serif",
            "literal": "var(--sans)"
