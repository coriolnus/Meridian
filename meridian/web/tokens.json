      "sans": {
        "$description": "Gövde ve başlık ailesi. Yedekler sistem yüzlerine düşer.",
        "$extensions": {
          "org.meridian.css": {
            "var": "--sans",
            "literal": "'Geist',system-ui,-apple-system,'Segoe UI',sans-serif"
          }
        },
        "$value": [
          "Geist",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ]
      },
      "mono": {
        "$description": "Etiket ve HER SAYI. Geist Mono'nun rakamları yapısal olarak eşit genişlikte (600/1000) ve sıfırı varsayılan glifte eğik çizgili — bkz. DESIGN.md § numeric-typography.",
        "$extensions": {
          "org.meridian.css": {
            "var": "--mono",
            "literal": "'Geist Mono',ui-monospace,SFMono-Regular,monospace"
          }
        },
        "$value": [
          "Geist Mono",
          "ui-monospace",
          "SFMono-Regular",
          "monospace"
